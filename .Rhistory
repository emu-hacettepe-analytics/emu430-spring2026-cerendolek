df$City <- stri_trans_general(df$City, "latin-ascii")
tr_map$name <- stri_trans_general(tr_map$name, "latin-ascii")
# Son kalan iki inatçı şehri haritadaki isimleriyle (Zinguldak ve K.Maras) eşliyoruz
df <- df %>%
mutate(City = case_when(
City == "Zonguldak" ~ "Zinguldak",
City == "Kahramanmaras" ~ "K.Maras",
TRUE ~ City
))
# 1. Verileri 'City' ve 'name' sütunları üzerinden eşleştiriyoruz
harita_veri <- left_join(tr_map, df, by = c("name" = "City"))
# 2. Sayı aralığına göre renk paleti (EVcount sütununa göre)
# Eğer bir hata alırsan EVcount'un sayısal (numeric) olduğundan emin olmalıyız
pal <- colorNumeric(palette = "YlOrRd", domain = harita_veri$EVcount, na.color = "transparent")
# 3. İnteraktif Harita
leaflet(harita_veri) %>%
addProviderTiles(providers$CartoDB.Positron) %>% # Sade beyaz-gri arkaplan
addPolygons(
fillColor = ~pal(EVcount),                   # Renklendirme EVcount'a göre
weight = 1,                                  # Çizgi inceliği
opacity = 1,
color = "white",                             # İl sınırları beyaz olsun
fillOpacity = 0.7,
highlightOptions = highlightOptions(         # Fareyle gelince parlaması için
weight = 3,
color = "#666",
fillOpacity = 0.9,
bringToFront = TRUE),
label = ~paste0(name, ": ", EVcount),        # Fareyle gelince çıkacak yazı
labelOptions = labelOptions(
style = list("font-weight" = "normal", padding = "3px 8px"),
textsize = "13px",
direction = "auto")
) %>%
addLegend(pal = pal, values = ~EVcount, opacity = 0.7, title = "Number of Electric Vehicle",
position = "bottomright")
