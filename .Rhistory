install.packages("rnaturalearthhires", repos = "https://ropensci.r-universe.dev")
df <- read.csv("C:/Users/crndo/OneDrive/Belgeler/GitHub/emu430-spring2026-cerendolek/NumofEV.csv",
header = TRUE,
sep = ";", # Excel'den CSV yapınca genelde noktalı virgül olur
encoding = "UTF-8")
tr_map <- ne_states(country = "Turkey", returnclass = "sf")
View(tr_map)
View(tr_map)
# Şablon düzgün geldi mi diye basitçe çizdirip bakalım
plot(st_geometry(tr_map))
# 1. Harita şablonu ile senin verini eşleştiriyoruz
# (Senin csv'deki sütun adının 'City' olduğunu varsayıyorum)
harita_veri <- left_join(tr_map, df, by = c("name" = "City"))
# 2. Sayılara göre kırmızının tonlarını ayarlayacak paleti oluşturuyoruz
# Not: Eğer sütun adın farklıysa 'EV.Count' kısmını ona göre düzeltmelisin
pal <- colorNumeric(palette = "Reds", domain = harita_veri$EV.Count)
# 3. İsteğine birebir uygun, çok sade ve interaktif haritayı çizdiriyoruz!
leaflet(harita_veri) %>%
addTiles() %>%  # Standart, sade bir arkaplan
addPolygons(
fillColor = ~pal(EV.Count),                  # İçi sayıya göre kırmızı tonu olacak
weight = 1,                                  # İl sınırlarının inceliği
color = "black",                             # İl sınırlarının rengi
fillOpacity = 0.8,                           # Renklerin belirginliği
label = ~paste(name, "-", EV.Count)          # Fareyle gelince çıkacak yazı (Örn: Ankara - 56785)
)
View(pal)
View(pal)
# 1. Verileri 'City' ve 'name' sütunları üzerinden eşleştiriyoruz
harita_veri <- left_join(tr_map, df, by = c("name" = "City"))
# 2. Sayı aralığına göre renk paleti (EVcount sütununa göre)
# Eğer bir hata alırsan EVcount'un sayısal (numeric) olduğundan emin olmalıyız
pal <- colorNumeric(palette = "YlOrRd", domain = harita_veri$EVcount, na.color = "transparent")
# 3. İnteraktif Harita
leaflet(harita_veri) %>%
addProviderTiles(providers$CartoDB.Positron) %>% # Sade beyaz-gri arkaplan
addPolygons(
fillColor = ~pal(EVcount),                   # Renklendirme EVcount'a göre
weight = 1,                                  # Çizgi inceliği
opacity = 1,
color = "white",                             # İl sınırları beyaz olsun
fillOpacity = 0.7,
highlightOptions = highlightOptions(         # Fareyle gelince parlaması için
weight = 3,
color = "#666",
fillOpacity = 0.9,
bringToFront = TRUE),
label = ~paste0(name, ": ", EVcount),        # Fareyle gelince çıkacak yazı
labelOptions = labelOptions(
style = list("font-weight" = "normal", padding = "3px 8px"),
textsize = "13px",
direction = "auto")
) %>%
addLegend(pal = pal, values = ~EVcount, opacity = 0.7, title = "EV Sayısı",
position = "bottomright")
